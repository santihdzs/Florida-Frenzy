generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CardCategory {
  ATTACK
  DEFENSE
  STATUS
  SPECIAL
}

enum CardElement {
  FIRE
  WATER
  SWAMP
  SAND
  ICE
}

enum CardRarity {
  BASE
  EFFECT
  RARE
  LEGENDARY
}

enum EnemyType {
  PLATFORMER_ENEMY
  CARD_ENEMY
  FINAL_BOSS
}

enum Faction {
  RAT
  RACCOON
  BEAR
  PYTHON
}

enum AiLevel {
  EASY
  MEDIUM
  HARD
}

enum ZoneDifficulty {
  EASY
  MEDIUM
  HARD
  FINAL
}

enum RunStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum BattleResult {
  WIN
  LOSE
}

enum RunZoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum RewardType {
  CARD
  CHARACTER
  XP
  COINS
}

enum AuthProvider {
  LOCAL
  FIREBASE
  BOTH
}

enum FriendStatus {
  PENDING
  ACCEPTED
}

// Dual auth model:
//   - Firebase users: firebaseUid is set, passwordHash may be null
//   - Local users: passwordHash is set (bcrypt of client-side SHA-256 hash), firebaseUid may be null
//   - Both: firebaseUid and passwordHash are both set
//   Client sends: SHA-256(plaintext password) over the wire
//   Server stores: bcrypt(SHA-256 hash) in passwordHash
// CHECK: at least one of firebaseUid or passwordHash must be non-null (enforced at app level)
model Player {
  id           Int          @id @default(autoincrement())
  firebaseUid  String?      @unique
  passwordHash String?
  authProvider AuthProvider @default(LOCAL)
  username     String       @unique
  email        String       @unique
  maxXp        Int          @default(0)
  totalCoins   Int          @default(0)
  isAdmin            Boolean      @default(false)
  isMuted            Boolean      @default(false)
  maxHp              Int          @default(50)
  firstLogin         DateTime     @default(now())
  lastLogin          DateTime?
  totalGamesPlayed   Int          @default(0)
  totalEnemiesKilled Int          @default(0)
  bulletDamage       Int          @default(10)
  fireRate           Int          @default(1)
  reloadTime         Int          @default(1)
  hasNoReload        Boolean      @default(false)
  magSize            Int          @default(10)
  staminaPool        Int          @default(1)
  staminaRegen       Int          @default(1)

  playerCharacters PlayerCharacter[]
  playerCards      PlayerCard[]
  decks            Deck[]
  runs             Run[]
  sentRequests     Friendship[]     @relation("SentRequests")
  receivedRequests Friendship[]     @relation("ReceivedRequests")

  @@index([maxXp])
}

model CharacterGame {
  id                Int     @id @default(autoincrement())
  chName            String  @unique
  chDesc            String?
  baseHp            Int     @default(100)
  baseAttack        Int     @default(0)
  baseDefense       Int     @default(0)
  chUltimate        String
  chUltimateDesc    String?
  isDefaultUnlocked Boolean @default(false)

  playerCharacters PlayerCharacter[]
  decks            Deck[]
  rewards          Reward[]
}

model CardGame {
  id                   Int          @id @default(autoincrement())
  cardName             String       @unique
  cardCategory         CardCategory
  cardElement          CardElement
  cardNumber           Int?
  cardEffect           String?
  effectDesc           String?
  baseDamage           Int          @default(0)
  shieldValue          Int          @default(0)
  effectValue          Int          @default(0)
  effectDuration       Int          @default(0)
  effectValueSecondary Int          @default(0)
  energyEGain          Int          @default(0)
  energyIGain          Int          @default(0)
  energyECost          Int          @default(0)
  energyICost          Int          @default(0)
  cardRarity           CardRarity   @default(BASE)

  playerCards PlayerCard[]
  deckCards   DeckCard[]
  rewards     Reward[]
}

model Enemy {
  id                Int       @id @default(autoincrement())
  enemyName         String    @unique
  enemyDesc         String?
  enemyType         EnemyType
  faction           Faction
  enemyBaseHp       Int       @default(100)
  enemyUltimate     String?
  enemyUltimateDesc String?
  aiLevel           AiLevel   @default(EASY)

  battles Battle[]
}

model ZoneGame {
  id             Int            @id @default(autoincrement())
  zoneName       String         @unique
  zoneMap        String?
  zoneDesc       String?
  zoneDifficulty ZoneDifficulty @default(EASY)

  runZones RunZone[]
  battles  Battle[]
}

model PlayerCharacter {
  id              Int           @id @default(autoincrement())
  playerId        Int
  player          Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  characterGameId Int
  characterGame   CharacterGame @relation(fields: [characterGameId], references: [id], onDelete: Cascade)
  isUnlocked      Boolean       @default(false)
  usedTimes       Int           @default(0)

  @@unique([playerId, characterGameId])
}

model PlayerCard {
  id            Int      @id @default(autoincrement())
  playerId      Int
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  cardGameId    Int
  cardGame      CardGame @relation(fields: [cardGameId], references: [id], onDelete: Cascade)
  numCardsOwned Int      @default(1)
  isUnlocked    Boolean  @default(false)

  @@unique([playerId, cardGameId])
}

// UNIQUE(playerId) WHERE isActive = true — enforced at app level (Prisma doesn't support partial unique indexes natively)
model Deck {
  id              Int           @id @default(autoincrement())
  deckName        String
  isActive        Boolean       @default(false)
  creationDate    DateTime      @default(now())
  playerId        Int
  player          Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  characterGameId Int
  characterGame   CharacterGame @relation(fields: [characterGameId], references: [id], onDelete: Cascade)

  deckCards DeckCard[]
  runs      Run[]

  @@unique([playerId, deckName])
  @@index([characterGameId])
}

model DeckCard {
  id            Int      @id @default(autoincrement())
  deckId        Int
  deck          Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  cardGameId    Int
  cardGame      CardGame @relation(fields: [cardGameId], references: [id], onDelete: Cascade)
  cardsIncluded Int      @default(1)

  @@unique([deckId, cardGameId])
}

model Run {
  id            Int       @id @default(autoincrement())
  startTime     DateTime  @default(now())
  endTime       DateTime?
  runStatus     RunStatus @default(IN_PROGRESS)
  zonesDone     Int       @default(0) // Cached counter — kept in sync by application logic
  xpEarned      Int       @default(0)
  coinsEarned   Int       @default(0)
  maxLevel      Int       @default(1)
  playerId      Int
  player        Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  deckId        Int?
  deck          Deck?     @relation(fields: [deckId], references: [id], onDelete: SetNull)

  runZones RunZone[]
  battles  Battle[]

  @@index([playerId])
  @@index([deckId])
  @@index([runStatus])
  @@index([endTime])
}

model RunZone {
  id          Int           @id @default(autoincrement())
  order       Int
  status      RunZoneStatus
  claimReward Boolean       @default(false)
  zoneGameId  Int
  zoneGame    ZoneGame      @relation(fields: [zoneGameId], references: [id], onDelete: Cascade)
  runId       Int
  run         Run           @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, order])
  @@index([runId])
  @@index([zoneGameId])
}

model Battle {
  id                Int          @id @default(autoincrement())
  battleResult      BattleResult
  turnCount         Int          @default(0)
  playerHpRemaining Int          @default(0)
  enemyHpRemaining  Int          @default(0)
  startTime         DateTime     @default(now())
  endTime           DateTime?
  runId             Int
  run               Run          @relation(fields: [runId], references: [id], onDelete: Cascade)
  zoneGameId        Int
  zoneGame          ZoneGame     @relation(fields: [zoneGameId], references: [id], onDelete: Cascade)
  enemyId           Int
  enemy             Enemy        @relation(fields: [enemyId], references: [id], onDelete: Restrict)

  battleRewards BattleReward[]

  @@index([runId])
  @@index([zoneGameId])
  @@index([enemyId])
}

// CHECK: NOT (cardGameId IS NOT NULL AND characterGameId IS NOT NULL) — enforced at app level
model Reward {
  id              Int            @id @default(autoincrement())
  rewardName      String
  rewardType      RewardType
  rewardDesc      String?
  rewardValue     Int            @default(0)
  cardGameId      Int?
  cardGame        CardGame?      @relation(fields: [cardGameId], references: [id], onDelete: SetNull)
  characterGameId Int?
  characterGame   CharacterGame? @relation(fields: [characterGameId], references: [id], onDelete: SetNull)

  battleRewards BattleReward[]

  @@index([cardGameId])
  @@index([characterGameId])
}

model BattleReward {
  id           Int     @id @default(autoincrement())
  playerChoice Boolean @default(false)
  battleId     Int
  battle       Battle  @relation(fields: [battleId], references: [id], onDelete: Cascade)
  rewardId     Int
  reward       Reward  @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([battleId, rewardId])
  @@index([battleId])
  @@index([rewardId])
}

model Friendship {
  id         Int          @id @default(autoincrement())
  senderId   Int
  receiverId Int
  status     FriendStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  sender     Player       @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   Player       @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}
